# ═══════════════════════════════════════════════════════════════
# ZORUNLU — bunlar olmadan uygulama ayağa kalkmaz
# ═══════════════════════════════════════════════════════════════

NEXT_PUBLIC_SUPABASE_URL=https://your-deneyap-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role (sadece server-side API routes'larda kullanılır — asla client'a sızdırma)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Uygulama URL'si (e-posta linklerinde, OAuth redirect'lerinde kullanılır)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ═══════════════════════════════════════════════════════════════
# E-POSTA — bildirimler, davetler, dijest e-postaları için
# ═══════════════════════════════════════════════════════════════

# Gmail App Password ile test için:
# Gmail → Google Hesabı → Güvenlik → 2 Adımlı Doğrulama → Uygulama Şifreleri
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your@gmail.com
SMTP_PASS=your-gmail-app-password
FROM_EMAIL="DENEYAP Ops <your@gmail.com>"

# Cron/dijest endpoint'lerini doğrulamak için rastgele bir string
CRON_SECRET=replace-with-random-secret

# ═══════════════════════════════════════════════════════════════
# AI GÖREV ASİSTANI — Gemini
# ═══════════════════════════════════════════════════════════════

# Ücretsiz anahtar: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# ═══════════════════════════════════════════════════════════════
# GOOGLE OAUTH — "Google ile Giriş Yap" + Drive + Takvim entegrasyonu
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# ═══════════════════════════════════════════════════════════════

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Drive bağlantısı için redirect URI (Google Cloud Console'da yetkili redirect URI olarak eklenmeli)
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/drive/callback
# Google Calendar bağlantısı için redirect URI
GOOGLE_GCAL_REDIRECT_URI=https://your-app.vercel.app/api/gcal/callback
# Drive dosyalarının hangi Google hesabı altında saklanacağı (workspace admin hesabı)
DRIVE_ADMIN_USER_ID=admin-google-user-id

# ═══════════════════════════════════════════════════════════════
# OPSİYONEL — olmadan da çalışır, ama production'da önerilir
# ═══════════════════════════════════════════════════════════════

# Süper admin paneline erişim (boş bırakılırsa süper admin özelliği pasif kalır)
NEXT_PUBLIC_SUPER_ADMIN_EMAIL=
SUPER_ADMIN_EMAIL=

# Cloudflare Turnstile — login/signup captcha (boş bırakılırsa captcha gösterilmez)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Upstash Redis — dağıtık rate limiting (yoksa in-memory fallback kullanılır;
# tek sunucuda çalışır ama Vercel gibi çoklu-instance ortamlarda gerçek koruma sağlamaz)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry — hata izleme (boş bırakılırsa Sentry aktif olmaz)
NEXT_PUBLIC_SENTRY_DSN=
