NEXT_PUBLIC_SUPABASE_URL=https://your-deneyap-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role (sadece server-side API routes'larda kullanılır)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SMTP — Gmail App Password ile test için:
# Gmail → Google Hesabı → Güvenlik → 2 Adımlı Doğrulama → Uygulama Şifreleri
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your@gmail.com
SMTP_PASS=your-gmail-app-password
FROM_EMAIL="DENEYAP Ops <your@gmail.com>"

# Uygulama URL'si (e-posta içindeki linklerde kullanılır)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Digest cron güvenlik anahtarı — rastgele bir string
CRON_SECRET=replace-with-random-secret

# Google Gemini API — AI Görev Asistanı için gerekli
# Ücretsiz anahtar: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
